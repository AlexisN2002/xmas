# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#
# xmas reads configuration from the environment. There is no config file and no
# credential ever lives in the repo.

# Base URL of an OpenAI-compatible endpoint.
XMAS_BASE_URL=https://api.tomzehle.com

# API key for that endpoint. Dummy value; replace locally.
XMAS_API_KEY=sk-replace-me
